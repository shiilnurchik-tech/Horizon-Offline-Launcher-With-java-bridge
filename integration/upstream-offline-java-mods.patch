diff --git a/crates/horizon-jvm/src/gate/tests.rs b/crates/horizon-jvm/src/gate/tests.rs
index 91b7bb8..e2da5af 100644
--- a/crates/horizon-jvm/src/gate/tests.rs
+++ b/crates/horizon-jvm/src/gate/tests.rs
@@ -287,0 +288,9 @@ fn the_services_check_reads_profile_and_entitlements() {
+
+#[test]
+fn offline_mods_require_both_explicit_arguments() {
+    assert_eq!(run(&[], &[], Services::DoesNot), (OptIn::Off, false));
+    assert_eq!(run(&[OFFLINE_ARG], &[], Services::DoesNot), (OptIn::Off, false));
+    assert_eq!(run(&[ARG], &[], Services::DoesNot), (OptIn::NoOwner(Refused::NoRecord), false));
+    assert_eq!(run(&[ARG, OFFLINE_ARG], &[], Services::DoesNot), (OptIn::Offline, false));
+    assert!(OptIn::Offline.runs());
+}
