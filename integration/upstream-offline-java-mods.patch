diff --git a/crates/horizon-jvm/src/renderers.rs b/crates/horizon-jvm/src/renderers.rs
index 1267b08dc..2894f31bf 100644
--- a/crates/horizon-jvm/src/renderers.rs
+++ b/crates/horizon-jvm/src/renderers.rs
@@ -97,0 +98,16 @@ pub fn mod_id(jar: &Path) -> Option<String> {
+/// A player-supplied Fabric API, identified by its metadata rather than its filename.
+/// Reject duplicates instead of loading an arbitrary version or loading two copies.
+pub fn selected_fabric_api(jars: &[PathBuf]) -> Result<Option<PathBuf>, String> {
+    let mut found = None;
+    for jar in jars {
+        if mod_id(jar).as_deref() != Some("fabric-api") {
+            continue;
+        }
+        if found.is_some() {
+            return Err("More than one Fabric API is in mods-java. Remove the extra copies and keep only the version you want.".into());
+        }
+        found = Some(jar.clone());
+    }
+    Ok(found)
+}
+
@@ -154,0 +171,23 @@ mod tests {
+    #[test]
+    fn player_fabric_api_is_chosen_by_metadata_and_duplicates_are_rejected() {
+        use std::io::Write;
+        let dir = std::env::temp_dir().join(format!("horizon-fabric-api-choice-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let jar = |name: &str, id: &str| {
+            let path = dir.join(name);
+            let mut zip = zip::ZipWriter::new(std::fs::File::create(&path).unwrap());
+            zip.start_file("fabric.mod.json", zip::write::SimpleFileOptions::default()).unwrap();
+            write!(zip, "{{\"id\":\"{id}\"}}").unwrap();
+            zip.finish().unwrap();
+            path
+        };
+        let other = jar("fabric-api-not-really.jar", "some-other-mod");
+        let chosen = jar("renamed.jar", "fabric-api");
+        let duplicate = jar("another.jar", "fabric-api");
+        assert_eq!(selected_fabric_api(&[other.clone()]).unwrap(), None);
+        assert_eq!(selected_fabric_api(&[other, chosen.clone()]).unwrap(), Some(chosen.clone()));
+        assert!(selected_fabric_api(&[chosen, duplicate]).unwrap_err().contains("More than one Fabric API"));
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+
